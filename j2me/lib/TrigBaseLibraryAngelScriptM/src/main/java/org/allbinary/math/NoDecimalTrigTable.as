    int16 antiTan(int dx, int dy)
    {
        int64 MAX_VALUE = (int64(Integer::MAX_VALUE));
        int64 MIN_VALUE = (int64(Integer::MIN_VALUE));
        int64 ratio = (MAX_VALUE - 1);
        if (dy != 0) {
            int64 dxl = (int64(dx));
            ratio = int64(this.SCALE) * dxl / int64(dy);
            if (dx <= 0 && dy < 0) {
                ratio = this.mathUtil_NoDecimalTrigTable.abslong(ratio);
            }
        }
        if ((dx >= 0 && dy < 0)) {
            for (int index = 180; index > 90; index--) {
                if (ratio <= this.noDecimalTan_NoDecimalTrigTable[index]) {
                    if (ratio > this.noDecimalTan_NoDecimalTrigTable[index - 1]) {
                        return (int16(index));
                    } else if (this.noDecimalTan_NoDecimalTrigTable[index - 1] == MAX_VALUE && ratio > MIN_VALUE) {
                        return (int16(index));
                    }
                }
            }
        } else if ((dx < 0 && dy <= 0)) {
            for (int index = 270; index > 180; index--) {
                if (ratio < this.noDecimalTan_NoDecimalTrigTable[index] && ratio >= this.noDecimalTan_NoDecimalTrigTable[index - 1]) {
                    return (int16(index));
                }
            }
        } else if ((dx < 0 && dy > 0)) {
            for (int index = (int(this.noDecimalTan_NoDecimalTrigTable.length()) - 1); index > 270; index--) {
                if (ratio < this.noDecimalTan_NoDecimalTrigTable[index]) {
                    if (ratio >= this.noDecimalTan_NoDecimalTrigTable[index - 1]) {
                        return (int16(index));
                    } else if (this.noDecimalTan_NoDecimalTrigTable[index - 1] == MAX_VALUE && ratio >= MIN_VALUE) {
                        return (int16(index));
                    }
                }
            }
        } else if ((dx >= 0 && dy >= 0)) {
            for (int index = 90; index > 0; index--) {
                if (ratio < this.noDecimalTan_NoDecimalTrigTable[index] && ratio >= this.noDecimalTan_NoDecimalTrigTable[index - 1]) {
                    return (int16(index));
                }
            }
        }
        StringMaker@ stringBuffer = StringMaker().jinit_StringMaker();
        stringBuffer.append("Invalid Ratio: ");
        stringBuffer.appendlong(ratio);
        stringBuffer.append(CommonSeps::getInstance().SPACE);
        stringBuffer.append(PositionStrings::getInstance().DX_LABEL);
        stringBuffer.appendint(dx);
        stringBuffer.append(CommonSeps::getInstance().SPACE);
        stringBuffer.append(PositionStrings::getInstance().DX_LABEL);
        stringBuffer.appendint(dy);
        jthrow(Exception().jinit_Exception(stringBuffer.toString()));
        return 0;
    }
    

    int16 antiTanDebug(int screenX, int screenY, int targetX, int targetY)
    {
        string METHOD_NAME = "antiTanDebug";
        string TARGET_ANGLE = " Targeting angle: ";
        StringMaker@ stringMaker = StringMaker().jinit_StringMaker();
