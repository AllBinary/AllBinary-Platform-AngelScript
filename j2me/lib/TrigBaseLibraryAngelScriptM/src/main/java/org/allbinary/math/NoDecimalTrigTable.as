        int targetX2 = -targetX;
        int targetY2 = -targetY;
        int screenX2 = -screenX;
        int screenY2 = -screenY;
        int[]@ dx = array<int>(4);
        dx[0] = (screenX - targetX);
        dx[1] = (screenX - targetX2);
